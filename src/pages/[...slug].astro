---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HomeHero from '../components/HomeHero.astro';
import LeadPanel from '../components/LeadPanel.astro';
import HomeSections from '../components/HomeSections.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import AuthorRow from '../components/AuthorRow.astro';
import LeadForm from '../components/LeadForm.astro';
import images from '../data/images.json';
import { withBase } from '../lib/site.mjs';
import CaseCard from '../components/CaseCard.astro';
import CaseMosaic from '../components/CaseMosaic.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({ params: { slug: entry.data.url === '/' ? undefined : entry.data.url.replace(/^\/|\/$/g, '') }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const img = (images as any)[d.slug] || {};
const toc = headings.filter((h) => h.depth === 2);
const isForm = ['lead-form', 'form', 'contact'].includes(d.type);
const formKind = d.type === 'lead-form' ? 'audit' : d.type === 'form' ? 'brief' : 'contact';
const allCases = d.type === 'hub' ? (await getCollection('pages')).filter((p) => p.data.type === 'case').map((p) => p.data) : [];
const hd = d.type === 'case' && d.case && !d.highlights?.length ? { ...d, highlights: [
  { value: d.case.contacts, label: 'обращений за месяц' }, { value: d.case.contact_price, label: 'цена обращения' },
  { value: d.case.views, label: 'просмотров' }, { value: d.case.spend, label: 'затраты на продвижение' } ] } : d;
---
<Base d={d}>
  {d.type === 'home' ? <HomeHero slot="hero" d={d} /> : <PageHero slot="hero" d={hd} />}
  {d.type === 'home' ? <HomeSections d={d}><Content /></HomeSections> : (<>
    {allCases.length > 0 && (
      <section class="wrap section" aria-label="Кейсы" style="padding-bottom:0">
        <div class="section-head"><span class="wm" aria-hidden="true">Кейсы</span><p class="badge-row">Разделы</p><h2 class="h-section">Выберите нишу</h2></div>
        <div class="cq"><CaseMosaic /></div>
      </section>
    )}
    <div class="wrap content-area">
      <div class={`content-grid ${isForm ? 'is-form' : toc.length > 2 ? 'has-aside' : ''}`}>
        <div class="flow-col">
          <article class="prose flow">
            <Content />
          </article>
          {!isForm && d.type !== 'legal' && <div class="sec sec-tight"><AuthorRow author={d.author} date={d.date_modified} /></div>}
          {d.faq?.length > 0 && <div class="sec"><Faq items={d.faq} /></div>}
          {d.related?.length > 0 && <div class="sec"><Related items={d.related} /></div>}
        </div>
        {isForm ? <div id="form" class="form-col" style="scroll-margin-top:24px"><LeadForm kind={formKind} title={formKind === 'audit' ? 'Заявка на аудит' : formKind === 'brief' ? 'Бриф на проект' : 'Написать нам'} /></div> : toc.length > 2 && (
          <aside class="aside-col">
            <div class="aside-stack">
              <nav class="toc" aria-label="Содержание страницы"><p>На этой странице</p><ol>{toc.map((h, i) => <li><a href={`#${h.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>)}{d.faq?.length > 0 && <li><a href="#faq-title"><span>?</span>Частые вопросы</a></li>}</ol></nav>
              <div class="aside-cta"><p>Проверим ваш сайт или профиль Авито бесплатно</p><a class="btn btn-sun btn-sm" href={withBase('/audit-besplatno/')}>Получить аудит</a></div>
            </div>
          </aside>
        )}
      </div>
    </div>
  </>)}
  {d.type !== 'legal' && !isForm && <LeadPanel />}
</Base>
